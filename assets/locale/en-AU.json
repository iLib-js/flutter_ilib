{
    "ilib.data.localeinfo": {
        "locale": "en-AU",
        "numfmt": {
            "exponential": "e"
        }
    },
    "ilib.data.dateformats": {
        "gregorian": {
            "date": {
                "dm": {
                    "f": "d MMMM",
                    "l": "d MMMM",
                    "m": "d MMM",
                    "s": "d/M"
                },
                "dmw": {
                    "f": "EEEE, d MMMM",
                    "l": "EEE, d MMMM",
                    "m": "EE, d MMM",
                    "s": "E, d/M"
                },
                "dmwy": {
                    "f": "EEEE, d MMMM yyyy",
                    "l": "EEE, d MMMM yyyy",
                    "m": "EE, d MMM yyyy",
                    "s": "E, d/M/yy"
                },
                "dmy": {
                    "f": "d MMMM yyyy",
                    "l": "d MMMM yyyy",
                    "m": "d MMM yyyy",
                    "s": "d/M/yy"
                },
                "e": {
                    "f": "cccc",
                    "l": "ccc",
                    "m": "cc",
                    "s": "c"
                },
                "my": {
                    "f": "MMMM yyyy",
                    "l": "MMMM yyyy",
                    "m": "MMM yyyy"
                }
            },
            "range": {
                "c00": {
                    "f": "{sd} {sm} {sy} at {st} – {et}",
                    "l": "{sd} {sm} {sy} at {st} – {et}",
                    "m": "{sd} {sm} {sy}, {st} – {et}",
                    "s": "{sd}/{sm}/{sy}, {st} – {et}"
                },
                "c01": {
                    "f": "{sd} {sm} {sy} at {st} – {ed} {em} {ey} at {et}",
                    "l": "{sd} {sm} {sy} at {st} – {ed} {em} {ey} at {et}",
                    "m": "{sd} {sm} {sy}, {st} – {ed} {em} {ey}, {et}",
                    "s": "{sd}/{sm}/{sy}, {st} – {ed}/{em}/{ey}, {et}"
                },
                "c02": {
                    "f": "{sd} {sm} {sy} at {st} – {ed} {em} {ey} at {et}",
                    "l": "{sd} {sm} {sy} at {st} – {ed} {em} {ey} at {et}",
                    "m": "{sd} {sm} {sy}, {st} – {ed} {em} {ey}, {et}",
                    "s": "{sd}/{sm}/{sy}, {st} – {ed}/{em}/{ey}, {et}"
                },
                "c03": {
                    "f": "{sd} {sm} {sy} at {st} – {ed} {em} {ey} at {et}",
                    "l": "{sd} {sm} {sy} at {st} – {ed} {em} {ey} at {et}",
                    "m": "{sd} {sm} {sy}, {st} – {ed} {em} {ey}, {et}",
                    "s": "{sd}/{sm}/{sy}, {st} – {ed}/{em}/{ey}, {et}"
                },
                "c10": {
                    "f": "{sd} – {ed} {em} {ey}",
                    "l": "{sd} – {ed} {em} {ey}",
                    "m": "{sd} – {ed} {em} {ey}",
                    "s": "{sd} – {ed}/{em}/{ey}"
                },
                "c11": {
                    "f": "{sd} {sm} – {ed} {em} {ey}",
                    "l": "{sd} {sm} – {ed} {em} {ey}",
                    "m": "{sd} {sm} – {ed} {em} {ey}",
                    "s": "{sd}/{sm} – {ed}/{em}/{ey}"
                },
                "c12": {
                    "f": "{sd} {sm} {sy} – {ed} {em} {ey}",
                    "l": "{sd} {sm} {sy} – {ed} {em} {ey}",
                    "m": "{sd} {sm} {sy} – {ed} {em} {ey}",
                    "s": "{sd}/{sm}/{sy} – {ed}/{em}/{ey}"
                },
                "c20": {
                    "f": "{sm} {sy} – {em} {ey}",
                    "l": "{sm} {sy} – {em} {ey}",
                    "m": "{sm} {sy} – {em} {ey}"
                }
            }
        }
    },
    "ilib.data.sysres": {
        "#in {num}h": "one#in {num} hr|#in {num} hrs",
        "#in {num}mi": "one#in {num} min|#in {num} mins",
        "#in {num}mo": "one#in {num} mo|#in {num} mo",
        "#in {num}s": "one#in {num} sec|#in {num} secs",
        "#in {num}w": "one#in {num} wk|#in {num} wks",
        "#in {num}y": "one#in {num} yr|#in {num} yrs",
        "#{num}h ago": "one#{num} hr ago|#{num} hrs ago",
        "#{num}mi ago": "one#{num} min ago|#{num} mins ago",
        "#{num}mo ago": "one#{num} mo ago|#{num} mo ago",
        "#{num}s ago": "one#{num} sec ago|#{num} secs ago",
        "#{num}w ago": "one#{num} wk ago|#{num} wks ago",
        "#{num}y ago": "one#{num} yr ago|#{num} yrs ago",
        "1#1 hr|#{num} hrs": "one#{num} hr|#{num} hrs",
        "1#1 min|#{num} min": "one#{num} min|#{num} mins",
        "1#1 sec|#{num} sec": "one#{num} sec|#{num} secs",
        "B1": "am",
        "B3": "midday",
        "B5": "pm",
        "E0": "Su.",
        "E1": "M.",
        "E2": "Tu.",
        "E3": "W.",
        "E4": "Th.",
        "E5": "F.",
        "E6": "Sa.",
        "MMM6": "June",
        "MMM7": "July",
        "MMM9": "Sept",
        "a0": "am",
        "a1": "pm",
        "c0": "S",
        "c1": "M",
        "c2": "T",
        "c3": "W",
        "c4": "T",
        "c5": "F",
        "c6": "S",
        "cc0": "Su",
        "cc1": "Mo",
        "cc2": "Tu",
        "cc3": "We",
        "cc4": "Th",
        "cc5": "Fr",
        "cc6": "Sa",
        "ccc0": "Sun",
        "ccc1": "Mon",
        "ccc2": "Tue",
        "ccc3": "Wed",
        "ccc4": "Thu",
        "ccc5": "Fri",
        "ccc6": "Sat",
        "cccc0": "Sunday",
        "cccc1": "Monday",
        "cccc2": "Tuesday",
        "cccc3": "Wednesday",
        "cccc4": "Thursday",
        "cccc5": "Friday",
        "cccc6": "Saturday"
    }
}