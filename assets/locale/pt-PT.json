{
    "ilib.data.plurals": {
        "many": {
            "or": [
                {
                    "and": [
                        {
                            "eq": [
                                "e",
                                0
                            ]
                        },
                        {
                            "neq": [
                                "i",
                                0
                            ]
                        },
                        {
                            "eq": [
                                {
                                    "mod": [
                                        "i",
                                        1000000
                                    ]
                                },
                                0
                            ]
                        },
                        {
                            "eq": [
                                "v",
                                0
                            ]
                        }
                    ]
                },
                {
                    "neq": [
                        "e",
                        [
                            0,
                            5
                        ]
                    ]
                }
            ]
        },
        "one": {
            "and": [
                {
                    "eq": [
                        "i",
                        1
                    ]
                },
                {
                    "eq": [
                        "v",
                        0
                    ]
                }
            ]
        }
    },
