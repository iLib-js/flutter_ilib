        "many": {
            "or": [
                {
                    "and": [
                        {
                            "eq": [
                                "e",
                                0
                            ]
                        },
                        {
                            "neq": [
                                "i",
                                0
                            ]
                        },
                        {
                            "eq": [
                                {
                                    "mod": [
